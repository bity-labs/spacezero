{
  "name": "@spacezero/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/styles/globals.css"
  ],
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "storybook": "storybook dev -p 6006",
    "storybook:check": "node ../../scripts/check-storybook.mjs",
    "storybook:build": "pnpm storybook:check && storybook build"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.18",
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/inter": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "shadcn": "4.19.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@tailwindcss/vite": "4.1.18",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.5.10",
    "typescript": "6.0.3",
    "vite": "7.3.6"
  }
}
