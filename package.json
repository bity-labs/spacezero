{
  "name": "spacezero",
  "version": "0.0.0",
  "description": "The zero-friction workspace for agentic development.",
  "main": "./out/main/index.js",
  "author": "Bity Labs",
  "homepage": "https://spacezero.dev",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "package:prepare-github": "node scripts/prepare-github-app-config.mjs",
    "build:mac": "npm run build && npm run package:prepare-github && electron-builder --mac",
    "build:win": "npm run build && npm run package:prepare-github && electron-builder --win",
    "build:linux": "npm run build && npm run package:prepare-github && electron-builder --linux"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@earendil-works/pi-agent-core": "^0.80.6",
    "@earendil-works/pi-ai": "^0.80.6",
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "@electron-toolkit/preload": "latest",
    "@electron-toolkit/utils": "latest",
    "@fontsource-variable/geist": "^5.2.9",
    "@monaco-editor/react": "^4.7.0",
    "@octokit/rest": "^22.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "@shadcn/react": "^0.2.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tiptap/extension-highlight": "^3.28.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-list": "^3.28.0",
    "@tiptap/extension-table": "^3.28.0",
    "@tiptap/markdown": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "better-sqlite3": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "cmdk": "^1.1.1",
    "drizzle-orm": "latest",
    "electron-log": "latest",
    "i18next": "^26.3.4",
    "material-icon-theme": "^5.37.0",
    "monaco-editor": "^0.56.0",
    "motion": "^12.42.2",
    "nanoid": "^5.1.16",
    "react": "latest",
    "react-arborist": "^3.15.1",
    "react-dom": "latest",
    "react-i18next": "^17.0.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "latest",
    "zod": "latest",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "latest",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/router-plugin": "^1.168.19",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "electron-vite": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "playwright": "latest",
    "prettier": "latest",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "latest",
    "vite": "^7.3.6",
    "vitest": "latest"
  },
  "build": {
    "appId": "dev.spacezero.app",
    "productName": "Space Zero",
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "resources/github-app.json",
        "to": "github-app.json"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  }
}
